rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /submissions/{submissionId} {
      // Participants need to read all submission records for the
      // authenticated leaderboard/statistics page. The UI does not
      // display user email addresses in the leaderboard.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      // All authenticated participants can see who has booked an activity.
      allow read: if request.auth != null;

      // A booking belongs to the signed-in user. The document ID is
      // intentionally user-scoped so many users can book the same activity.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
